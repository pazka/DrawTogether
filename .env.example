# drawtogether — environment. Copy to drawtogether.env (chmod 600), never commit the real file.
# The defaults below are the hosh.it box values: copying this file unchanged is enough. No secret:
# the app has no login (a room URL is its only key) and calls no external service.
# required:
# (no owner secret is needed)

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/drawtogether:v1.2.0'
APP_BIND='127.0.0.1:9135'
